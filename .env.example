# ============================================================================
# Rudel — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# For local development with Docker (bun run dev:local), all defaults work
# out of the box — you only need to set BETTER_AUTH_SECRET.
# ============================================================================

# --- Required ----------------------------------------------------------------

# Postgres connection string (any Postgres; see docs/self-hosting.md)
PG_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/rudel

# Auth secret used by better-auth for signing tokens/cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- ClickHouse ---------------------------------------------------------------
# For local dev, the Docker container (bun run dev:local) provides ClickHouse.
# For hosted ClickHouse, get credentials at https://obsessiondb.com

# ClickHouse HTTP endpoint. Local Docker uses port 8123; hosted ClickHouse
# endpoints typically serve HTTPS on port 443.
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse credentials. CLICKHOUSE_USERNAME is canonical; CLICKHOUSE_USER is
# accepted as a legacy fallback, and setting both to different values is an
# error. Local Docker default password is "clickhouse".
#
# "default" is the ClickHouse superuser, so it is only assumed for a local
# endpoint. Pointing CLICKHOUSE_URL at a remote host without a username is an
# error rather than a silent fall back to `default`.
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ClickHouse database name. Used by chkit tooling for schema migrations.
# Not read by the API at runtime (hardcoded to "rudel" in queries).
# CLICKHOUSE_DB=rudel

# --- API Server ---------------------------------------------------------------

# Base URL of the API server. Used as better-auth's baseURL and automatically
# added to trusted origins. Default: http://localhost:4010
# APP_URL=http://localhost:4010

# Preferred frontend origin for auth emails and redirects.
# Dev CORS/trusted origins include localhost and 127.0.0.1 on ports 4011-4015
# by default, so either browser hostname works locally.
# Default: http://localhost:4011
# ALLOWED_ORIGIN=http://localhost:4011

# Comma-separated list of trusted origins for better-auth CSRF protection.
# APP_URL is automatically appended.
# TRUSTED_ORIGINS=http://localhost:4011,http://127.0.0.1:4011,http://localhost:4015

# Number of trusted reverse proxies in front of the API, or in front of Fly
# Proxy. Leave at 0 for direct connections and direct Fly deployments.
# TRUSTED_PROXY_HOPS=0

# Server listen port. Default: 4010. Overridden to 3000 in the Docker image.
# PORT=4010

# Directory for static file serving (SPA). Relative to apps/api/.
# In production, the web app is built and copied to apps/api/public/.
# Default: public
# STATIC_DIR=public

# Process-wide transcript filtering queue. Limits include the active filtering
# job plus all jobs waiting behind it. Defaults allow two maximum-size
# transcripts globally but only one maximum-size transcript per user.
# INGEST_FILTER_QUEUE_GLOBAL_MAX_BYTES=268435456
# INGEST_FILTER_QUEUE_GLOBAL_MAX_JOBS=8
# INGEST_FILTER_QUEUE_PER_USER_MAX_BYTES=134217728
# INGEST_FILTER_QUEUE_PER_USER_MAX_JOBS=5
# Applies separately to queue wait and active filtering.
# INGEST_FILTER_QUEUE_TIMEOUT_MS=30000

# Browser verification URL shown by `rudel login` device-code auth.
# Local dev should point at the Vite web app. Default:
# http://localhost:4011/device
# CLI_DEVICE_VERIFICATION_URL=http://localhost:4011/device

# --- CLI ----------------------------------------------------------------------

# CLI API target. Production CLI defaults to https://app.rudel.ai.
# Local dev can point the CLI at the local API without changing saved prod creds:
# RUDEL_CONFIG_DIR=.context/rudel-local-cli RUDEL_API_BASE=http://localhost:4010 rudel login
# RUDEL_API_BASE=http://localhost:4010
# Plaintext non-loopback upload destinations require their own explicit opt-in:
# RUDEL_ALLOW_INSECURE_ENDPOINT=1

# --- OAuth Providers (optional) -----------------------------------------------
# Enable social login by providing OAuth credentials. If not set, only
# email/password authentication is available.

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Integrations (optional) --------------------------------------------------

# Slack incoming webhook URL. When set, sends a notification to the channel
# on every new user signup.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Resend email integration.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Rudel <noreply@example.com>
# RESEND_AUDIENCE_ID=

# Chatwoot website widget for the dashboard support launcher.
# These are baked into the frontend at Vite build time (VITE_ prefix).
# VITE_CHATWOOT_BASE_URL=https://app.chatwoot.com
# VITE_CHATWOOT_WEBSITE_TOKEN=
# VITE_CHATWOOT_ENABLED=true
# Server-only HMAC token from the matching Chatwoot inbox's Identity Validation
# settings. Never expose this value through a VITE_* variable.
# CHATWOOT_IDENTITY_VERIFICATION_SECRET=

# PostHog product analytics.
# Keep disabled in local dev unless you explicitly want to test instrumentation.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_ENVIRONMENT=production
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_ENABLED=false

# Local-only frontend fixture mode for UI/routing work while analytics endpoints
# are unstable. Ignored in production builds because it is gated by import.meta.env.DEV.
# VITE_FRONTEND_FIXTURES=0
