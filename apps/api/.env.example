# See root .env.example for full documentation of all variables.

# Required
PG_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/rudel
BETTER_AUTH_SECRET=

# Local frontend origin used for auth links. Dev CORS/trusted origins include
# localhost and 127.0.0.1 on ports 4011-4015 by default.
# ALLOWED_ORIGIN=http://localhost:4011
# TRUSTED_ORIGINS=http://localhost:4011,http://127.0.0.1:4011,http://localhost:4015

# Number of trusted reverse proxies in front of the API, or in front of Fly
# Proxy. Leave at 0 for direct connections and direct Fly deployments.
# TRUSTED_PROXY_HOPS=0

# Anonymous Wrapped share lookup limits per API process.
# RATE_LIMIT_WRAPPED_SHARE_LOOKUP_MAX=180
# RATE_LIMIT_WRAPPED_SHARE_LOOKUP_WINDOW=60
# RATE_LIMIT_WRAPPED_SHARE_LOOKUP_CAPACITY=5000
# RATE_LIMIT_WRAPPED_SHARE_LOOKUP_SOURCE_MAX=600

# ClickHouse (get hosted credentials at https://obsessiondb.com)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=

# Server-only HMAC token from the Chatwoot website inbox's Identity Validation
# settings. Leave unset when the Chatwoot integration is disabled.
# CHATWOOT_IDENTITY_VERIFICATION_SECRET=

# CLI device-code browser verification URL.
# CLI_DEVICE_VERIFICATION_URL=http://localhost:4011/device

# Resend email (optional)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=     # Required to send organization invitation emails
# RESEND_AUDIENCE_ID=    # Optional: sync new signups to a Resend audience
#
# PostHog product analytics (optional)
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_ENABLED=false
