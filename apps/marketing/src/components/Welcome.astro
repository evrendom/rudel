---
const navigation = ["Product", "Resources", "Pricing", "Contact"];
---

<div class="dot-page" data-dot-page>
	<canvas class="dot-canvas" aria-hidden="true"></canvas>

	<header class="site-header">
		<div class="nav-shell">
			<a class="brand-link" href="/" aria-label="Homepage">
				<img
					class="dot-template brand-template"
					data-dot-image
					data-dot-opacity="0.96"
					data-dot-step="1.7"
					src="/opaline-wordmark.svg"
					alt=""
					width="102"
					height="23"
				/>
			</a>

			<nav class="desktop-navigation" aria-label="Main navigation">
				<ul role="list">
					{
						navigation.map((item) => (
							<li>
								<a href={`#${item.toLowerCase()}`}>
									<span
										data-dot-text={item}
										data-dot-opacity="0.68"
										data-dot-step="1.55"
									>
										{item}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<button
				class="mobile-menu-toggle"
				type="button"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-navigation"
				data-menu-toggle
			>
				<span data-dot-icon="menu" aria-hidden="true"></span>
			</button>
		</div>

		<nav
			class="mobile-navigation"
			id="mobile-navigation"
			aria-label="Mobile navigation"
			data-mobile-navigation
			hidden
		>
			<ul role="list">
				{
					navigation.map((item) => (
						<li>
							<a href={`#${item.toLowerCase()}`}>
								<span
									data-dot-text={item}
									data-dot-opacity="0.88"
									data-dot-step="2"
								>
									{item}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</header>

	<main class="hero" id="main" data-hero>
		<div class="hero-mark">
			<img
				class="dot-template mark-template"
				data-dot-image
				data-dot-invert
				data-dot-interactive
				data-dot-opacity="0.98"
				data-dot-step="2.15"
				src="/opaline-icon.svg"
				alt=""
				width="375"
				height="375"
			/>
		</div>

		<h1>
			<span class="headline-line desktop-headline-line" data-dot-text="Clarity for your team's">
				Clarity for your team's
			</span>
			<span class="headline-line desktop-headline-line" data-dot-text="agent sessions">
				agent sessions
			</span>
			<span class="headline-line mobile-headline-line" data-dot-text="Clarity for your">
				Clarity for your
			</span>
			<span class="headline-line mobile-headline-line" data-dot-text="team's agent">
				team's agent
			</span>
			<span class="headline-line mobile-headline-line" data-dot-text="sessions">
				sessions
			</span>
		</h1>

		<div class="hero-actions">
			<a href="#resources">
				<span data-dot-text="Developer docs" data-dot-opacity="0.86" data-dot-step="1.65">
					Developer docs
				</span>
				<span class="arrow-template" data-dot-icon="arrow" aria-hidden="true"></span>
			</a>
			<a href="#product">
				<span data-dot-text="Start building" data-dot-opacity="0.56" data-dot-step="1.65">
					Start building
				</span>
				<span class="arrow-template" data-dot-icon="arrow" aria-hidden="true"></span>
			</a>
		</div>
	</main>
</div>

<style>
	@font-face {
		font-family: "InterVariable";
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
		src: url("https://rsms.me/inter/font-files/InterVariable.woff2?v=4.1") format("woff2");
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #fff;
	}

	:global(body) {
		min-width: 320px;
		background: #fff;
		font-family: "InterVariable", Inter, Arial, sans-serif;
		font-feature-settings: "cv02", "cv03", "cv04", "cv11", "ss01", "ss03";
		-webkit-font-smoothing: antialiased;
	}

	button,
	a {
		font: inherit;
	}

	.dot-page {
		position: relative;
		isolation: isolate;
		min-height: max(100svh, 50.5rem);
		overflow: clip;
		background: #fff;
		color: transparent;
	}

	.dot-canvas {
		position: absolute;
		z-index: 10;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0;
		transition: opacity 800ms ease-out 100ms;
	}

	.dot-canvas[data-ready] {
		opacity: 1;
	}

	.site-header {
		position: absolute;
		z-index: 20;
		top: 0;
		left: 0;
		width: 100%;
		height: 6.125rem;
	}

	.nav-shell {
		display: flex;
		width: min(calc(100% - 5rem), 75rem);
		height: 100%;
		align-items: center;
		justify-content: space-between;
		margin: 0 auto;
	}

	.brand-link {
		display: flex;
		min-width: 3rem;
		min-height: 3rem;
		align-items: center;
		justify-content: flex-start;
		outline: none;
	}

	.dot-template {
		display: block;
		opacity: 0;
		user-select: none;
	}

	.brand-template {
		width: 6.375rem;
		height: auto;
	}

	.desktop-navigation ul {
		display: flex;
		align-items: center;
		gap: 2.75rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.desktop-navigation a,
	.hero-actions a {
		display: flex;
		min-height: 3rem;
		align-items: center;
		gap: 0.375rem;
		outline: none;
		text-decoration: none;
	}

	[data-dot-text] {
		color: transparent;
		-webkit-text-fill-color: transparent;
		user-select: none;
	}

	.desktop-navigation [data-dot-text] {
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.125rem;
		white-space: nowrap;
	}

	.mobile-menu-toggle,
	.mobile-navigation {
		display: none;
	}

	.hero {
		position: relative;
		z-index: 20;
		display: flex;
		min-height: max(100svh, 50.5rem);
		align-items: center;
		flex-direction: column;
		padding: 8.75rem 1.5rem 4.5rem;
	}

	.hero-mark {
		width: 23.4375rem;
		height: 23.4375rem;
	}

	.mark-template {
		width: 100%;
		height: 100%;
	}

	h1 {
		width: min(100%, 34.375rem);
		padding: 0;
		margin: 5rem 0 0;
		font-size: 2.75rem;
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 2.75rem;
		text-align: center;
		text-wrap: balance;
	}

	.headline-line {
		display: block;
		width: 100%;
	}

	.headline-line[data-dot-text] {
		--dot-text-role: headline;
	}

	.mobile-headline-line {
		display: none;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-top: 1.25rem;
	}

	.hero-actions a {
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.125rem;
	}

	.arrow-template {
		display: block;
		width: 1.125rem;
		height: 1.125rem;
	}

	.mobile-navigation[hidden] {
		display: none;
	}

	@media (max-width: 50.5625rem) {
		.dot-page,
		.hero {
			min-height: max(100svh, 47.5rem);
		}

		.site-header {
			height: 4.5rem;
		}

		.nav-shell {
			width: 100%;
			padding: 0 1rem;
		}

		.brand-template {
			width: 6.375rem;
		}

		.desktop-navigation {
			display: none;
		}

		.mobile-menu-toggle {
			position: relative;
			display: grid;
			width: 3rem;
			height: 3rem;
			place-items: center;
			padding: 0;
			border: 0;
			background: transparent;
			outline: none;
		}

		.mobile-menu-toggle span {
			display: block;
			width: 1.125rem;
			height: 1.125rem;
		}

		.mobile-navigation {
			position: absolute;
			top: 4.5rem;
			left: 0;
			display: flex;
			width: 100%;
			height: calc(max(100svh, 47.5rem) - 4.5rem);
			align-items: center;
			justify-content: center;
			background: transparent;
		}

		.mobile-navigation ul {
			display: flex;
			align-items: center;
			flex-direction: column;
			gap: 1rem;
			padding: 0;
			margin: 0;
			list-style: none;
		}

		.mobile-navigation a {
			display: flex;
			min-width: 14rem;
			min-height: 3rem;
			align-items: center;
			justify-content: center;
			outline: none;
			text-decoration: none;
		}

		.mobile-navigation [data-dot-text] {
			font-size: 2rem;
			font-weight: 400;
			letter-spacing: -0.03em;
			line-height: 2.5rem;
		}

		.dot-page[data-menu-open] .hero {
			visibility: hidden;
		}

		.hero {
			padding: 11.5625rem 1rem 2rem;
		}

		.hero-mark {
			width: 16rem;
			height: 16rem;
		}

		h1 {
			width: 100%;
			margin-top: 5rem;
			font-size: 2rem;
			letter-spacing: -0.035em;
			line-height: 2rem;
		}

		.desktop-headline-line {
			display: none;
		}

		.mobile-headline-line {
			display: block;
		}

		.hero-actions {
			gap: 1.25rem;
			margin-top: 0.75rem;
		}

		.hero-actions a {
			font-size: 1rem;
		}
	}

	@media (max-width: 22.5rem) {
		.hero-actions {
			gap: 0.75rem;
		}

		.hero-actions a {
			font-size: 0.875rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dot-canvas {
			transition: none;
		}
	}
</style>

<script>
	const page = document.querySelector("[data-dot-page]");
	const canvas = page?.querySelector(".dot-canvas");
	const menuToggle = page?.querySelector("[data-menu-toggle]");
	const mobileNavigation = page?.querySelector("[data-mobile-navigation]");
	const hero = page?.querySelector("[data-hero]");

	if (!(page instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) {
		throw new Error("The dotted hero surface is unavailable.");
	}

	const context = canvas.getContext("2d", { alpha: true, desynchronized: true });
	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
	const ink = [44, 45, 48];
	const pointerRadius = 100;
	const pointerStrength = 40;
	const smoothing = 0.12;
	const shockwave = {
		speed: 225,
		width: 37,
		strength: 20,
		duration: 675,
	};

	if (!context) throw new Error("The dotted hero requires a 2D canvas context.");

	let width = 0;
	let height = 0;
	let pixelRatio = 1;
	let rebuildFrame = 0;
	let animationFrame = 0;
	let interactiveDots = [];
	let interactiveBuckets = [];
	let staticLayer = document.createElement("canvas");
	let staticContext = staticLayer.getContext("2d");
	let activeMarkBounds = null;
	let activeFocusElement = null;
	let needsAnimation = false;
	const pointer = { x: -9999, y: -9999, active: false };
	let shockwaves = [];

	const isRendered = (element) => {
		const style = getComputedStyle(element);
		const rect = element.getBoundingClientRect();
		return (
			style.display !== "none" &&
			style.visibility !== "hidden" &&
			rect.width > 0 &&
			rect.height > 0
		);
	};

	const makeMask = (width, height) => {
		const mask = document.createElement("canvas");
		mask.width = Math.max(1, Math.ceil(width));
		mask.height = Math.max(1, Math.ceil(height));
		return { mask, maskContext: mask.getContext("2d", { willReadFrequently: true }) };
	};

	const dotsFromMask = ({
		maskContext,
		maskWidth,
		maskHeight,
		offsetX,
		offsetY,
		step,
		opacity,
		size = step * 0.58,
		interactive = false,
	}) => {
		if (!maskContext) return [];
		const pixels = maskContext.getImageData(0, 0, maskWidth, maskHeight).data;
		const dots = [];
		for (let y = 0; y < maskHeight; y += step) {
			for (let x = 0; x < maskWidth; x += step) {
				const sampleX = Math.min(maskWidth - 1, Math.round(x));
				const sampleY = Math.min(maskHeight - 1, Math.round(y));
				const alpha = pixels[(sampleY * maskWidth + sampleX) * 4 + 3] / 255;
				if (alpha < 0.035) continue;
				dots.push({
					x: offsetX + x,
					y: offsetY + y,
					originX: offsetX + x,
					originY: offsetY + y,
					displaceX: 0,
					displaceY: 0,
					brightness: alpha * opacity,
					size,
					interactive,
				});
			}
		}
		return dots;
	};

	const imageDots = (image) => {
		const rect = image.getBoundingClientRect();
		const step = Number.parseFloat(image.dataset.dotStep || "2");
		const opacity = Number.parseFloat(image.dataset.dotOpacity || "1");
		const { mask, maskContext } = makeMask(rect.width, rect.height);
		if (!maskContext || !image.complete) return [];

		if (image.hasAttribute("data-dot-invert")) {
			const edge = Math.min(mask.width, mask.height);
			const outerSize = edge * 0.84;
			const outerX = (mask.width - outerSize) / 2;
			const outerY = (mask.height - outerSize) / 2;
			const radius = outerSize * 0.2;
			maskContext.fillStyle = "#000";
			maskContext.beginPath();
			maskContext.roundRect(outerX, outerY, outerSize, outerSize, radius);
			maskContext.fill();
			const cutoutSize = outerSize * 0.63;
			maskContext.globalCompositeOperation = "destination-out";
			maskContext.drawImage(
				image,
				(mask.width - cutoutSize) / 2,
				(mask.height - cutoutSize) / 2,
				cutoutSize,
				cutoutSize,
			);
		} else {
			maskContext.drawImage(image, 0, 0, mask.width, mask.height);
		}

		return dotsFromMask({
			maskContext,
			maskWidth: mask.width,
			maskHeight: mask.height,
			offsetX: rect.left,
			offsetY: rect.top,
			step,
			opacity,
			interactive: image.hasAttribute("data-dot-interactive"),
		});
	};

	const textDots = (element) => {
		const rect = element.getBoundingClientRect();
		const style = getComputedStyle(element);
		const isHeadline = style.getPropertyValue("--dot-text-role") === "headline";
		const step = Number.parseFloat(
			element.dataset.dotStep || (isHeadline ? "2.35" : "1.6"),
		);
		const opacity = Number.parseFloat(
			element.dataset.dotOpacity || (isHeadline ? "0.84" : "1"),
		);
		const { mask, maskContext } = makeMask(rect.width, rect.height);
		if (!maskContext) return [];

		maskContext.fillStyle = "#000";
		maskContext.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
		maskContext.textAlign = style.textAlign === "center" ? "center" : "left";
		maskContext.textBaseline = "middle";
		maskContext.letterSpacing = style.letterSpacing;
		const text = element.dataset.dotText || element.textContent?.trim() || "";
		maskContext.fillText(
			text,
			style.textAlign === "center" ? mask.width / 2 : 0,
			mask.height / 2,
		);

		return dotsFromMask({
			maskContext,
			maskWidth: mask.width,
			maskHeight: mask.height,
			offsetX: rect.left,
			offsetY: rect.top,
			step,
			opacity,
		});
	};

	const iconDots = (element) => {
		const rect = element.getBoundingClientRect();
		const dots = [];
		const addDot = (x, y, size = 1.4, brightness = 0.82) => {
			dots.push({
				x: rect.left + x,
				y: rect.top + y,
				originX: rect.left + x,
				originY: rect.top + y,
				displaceX: 0,
				displaceY: 0,
				brightness,
				size,
				interactive: false,
			});
		};

		if (element.dataset.dotIcon === "arrow") {
			for (let x = 2; x <= 14; x += 2) addDot(x, 9, 1.15, 0.68);
			addDot(12, 5, 1.15, 0.68);
			addDot(14, 7, 1.15, 0.68);
			addDot(12, 13, 1.15, 0.68);
			addDot(14, 11, 1.15, 0.68);
		} else {
			const isOpen = page.hasAttribute("data-menu-open");
			if (isOpen) {
				for (let index = 0; index < 5; index += 1) {
					addDot(3 + index * 3, 3 + index * 3, 1.5, 0.92);
					addDot(15 - index * 3, 3 + index * 3, 1.5, 0.92);
				}
			} else {
				for (let row = 0; row < 3; row += 1) {
					for (let column = 0; column < 3; column += 1) {
						addDot(4 + column * 5, 4 + row * 5, 1.65, 0.92);
					}
				}
			}
		}
		return dots;
	};

	const focusDots = (element) => {
		if (!(element instanceof HTMLElement) || !page.contains(element)) return [];
		const rect = element.getBoundingClientRect();
		if (rect.width <= 0 || rect.height <= 0) return [];
		const dots = [];
		const inset = 2;
		const spacing = 6;
		const push = (x, y) =>
			dots.push({
				x,
				y,
				originX: x,
				originY: y,
				displaceX: 0,
				displaceY: 0,
				brightness: 0.58,
				size: 1.25,
				interactive: false,
			});
		for (let x = rect.left + inset; x <= rect.right - inset; x += spacing) {
			push(x, rect.top + inset);
			push(x, rect.bottom - inset);
		}
		for (let y = rect.top + inset + spacing; y < rect.bottom - inset; y += spacing) {
			push(rect.left + inset, y);
			push(rect.right - inset, y);
		}
		return dots;
	};

	const bucketDots = (dots) => {
		const buckets = Array.from({ length: 16 }, () => []);
		for (const dot of dots) {
			const bucket = Math.max(1, Math.min(15, Math.round(dot.brightness * 15)));
			buckets[bucket].push(dot);
		}
		return buckets;
	};

	const paintBuckets = (target, buckets, dynamic = false) => {
		for (let level = 1; level < buckets.length; level += 1) {
			const bucket = buckets[level];
			if (!bucket.length) continue;
			target.fillStyle = `rgba(${ink[0]}, ${ink[1]}, ${ink[2]}, ${level / 15})`;
			for (const dot of bucket) {
				const x = dynamic ? dot.originX + dot.displaceX : dot.x;
				const y = dynamic ? dot.originY + dot.displaceY : dot.y;
				target.fillRect(x - 0.25, y - 0.25, dot.size + 0.5, dot.size + 0.5);
			}
		}
	};

	const rebuild = () => {
		cancelAnimationFrame(rebuildFrame);
		rebuildFrame = requestAnimationFrame(() => {
			cancelAnimationFrame(animationFrame);
			animationFrame = 0;
			const bounds = page.getBoundingClientRect();
			width = bounds.width;
			height = bounds.height;
			pixelRatio = Math.min(devicePixelRatio || 1, 2);
			canvas.width = Math.max(1, Math.round(width * pixelRatio));
			canvas.height = Math.max(1, Math.round(height * pixelRatio));
			context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

			staticLayer.width = canvas.width;
			staticLayer.height = canvas.height;
			staticContext = staticLayer.getContext("2d");
			staticContext?.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

			const staticDots = [];
			interactiveDots = [];
			activeMarkBounds = null;

			for (const image of page.querySelectorAll("[data-dot-image]")) {
				if (!(image instanceof HTMLImageElement) || !isRendered(image)) continue;
				const dots = imageDots(image);
				if (image.hasAttribute("data-dot-interactive")) {
					interactiveDots.push(...dots);
					activeMarkBounds = image.getBoundingClientRect();
				} else staticDots.push(...dots);
			}

			for (const element of page.querySelectorAll("[data-dot-text]")) {
				if (!(element instanceof HTMLElement) || !isRendered(element)) continue;
				staticDots.push(...textDots(element));
			}

			for (const element of page.querySelectorAll("[data-dot-icon]")) {
				if (!(element instanceof HTMLElement) || !isRendered(element)) continue;
				staticDots.push(...iconDots(element));
			}

			if (activeFocusElement) staticDots.push(...focusDots(activeFocusElement));
			if (staticContext) paintBuckets(staticContext, bucketDots(staticDots));
			interactiveBuckets = bucketDots(interactiveDots);
			shockwaves = [];
			pointer.active = false;
			needsAnimation = false;
			draw(performance.now());
			requestAnimationFrame(() => canvas.dataset.ready = "");
		});
	};

	const draw = (time) => {
		animationFrame = 0;
		context.clearRect(0, 0, width, height);
		context.drawImage(staticLayer, 0, 0, width, height);

		const liveShockwaves = reducedMotion.matches
			? []
			: shockwaves.filter((wave) => time - wave.start < shockwave.duration);
		shockwaves = liveShockwaves;
		needsAnimation = liveShockwaves.length > 0;
		let hasDisplacement = false;

		for (const dot of interactiveDots) {
			let targetX = 0;
			let targetY = 0;
			if (pointer.active && !reducedMotion.matches) {
				const deltaX = dot.originX + dot.displaceX - pointer.x;
				const deltaY = dot.originY + dot.displaceY - pointer.y;
				const distanceSquared = deltaX * deltaX + deltaY * deltaY;
				if (distanceSquared < pointerRadius * pointerRadius && distanceSquared > 0.1) {
					const distance = Math.sqrt(distanceSquared);
					const force = Math.pow(1 - distance / pointerRadius, 3) * pointerStrength;
					targetX += deltaX / distance * force;
					targetY += deltaY / distance * force;
				}
			}

			for (const wave of liveShockwaves) {
				const elapsed = time - wave.start;
				const radius = elapsed / 1000 * shockwave.speed;
				const deltaX = dot.originX - wave.x;
				const deltaY = dot.originY - wave.y;
				const distance = Math.hypot(deltaX, deltaY);
				if (distance < 0.1) continue;
				const edgeDistance = Math.abs(distance - radius);
				if (edgeDistance < shockwave.width) {
					const decay = 1 - elapsed / shockwave.duration;
					const force = (1 - edgeDistance / shockwave.width) * decay * shockwave.strength;
					targetX += deltaX / distance * force;
					targetY += deltaY / distance * force;
				}
			}

			dot.displaceX += (targetX - dot.displaceX) * smoothing;
			dot.displaceY += (targetY - dot.displaceY) * smoothing;
			if (Math.abs(dot.displaceX) < 0.01) dot.displaceX = 0;
			if (Math.abs(dot.displaceY) < 0.01) dot.displaceY = 0;
			if (dot.displaceX || dot.displaceY) hasDisplacement = true;
		}

		paintBuckets(context, interactiveBuckets, true);
		needsAnimation ||= pointer.active || hasDisplacement;
		if (needsAnimation && !document.hidden) animationFrame = requestAnimationFrame(draw);
	};

	const inMarkField = (event) => {
		if (!activeMarkBounds) return false;
		const padding = 80;
		return (
			event.clientX >= activeMarkBounds.left - padding &&
			event.clientX <= activeMarkBounds.right + padding &&
			event.clientY >= activeMarkBounds.top - padding &&
			event.clientY <= activeMarkBounds.bottom + padding
		);
	};

	page.addEventListener("pointermove", (event) => {
		if (event.pointerType !== "mouse" || !inMarkField(event)) {
			pointer.active = false;
			return;
		}
		pointer.x = event.clientX;
		pointer.y = event.clientY;
		pointer.active = true;
		if (!animationFrame) animationFrame = requestAnimationFrame(draw);
	});

	page.addEventListener("pointerleave", () => {
		pointer.active = false;
		if (!animationFrame) animationFrame = requestAnimationFrame(draw);
	});

	page.addEventListener("pointerup", (event) => {
		if (!inMarkField(event) || reducedMotion.matches) return;
		shockwaves.push({ x: event.clientX, y: event.clientY, start: performance.now() });
		if (!animationFrame) animationFrame = requestAnimationFrame(draw);
	});

	page.addEventListener("focusin", (event) => {
		activeFocusElement = event.target instanceof HTMLElement ? event.target : null;
		rebuild();
	});

	page.addEventListener("focusout", () => {
		activeFocusElement = null;
		rebuild();
	});

	const setMenu = (open) => {
		if (!(menuToggle instanceof HTMLButtonElement) || !(mobileNavigation instanceof HTMLElement)) {
			return;
		}
		menuToggle.setAttribute("aria-expanded", String(open));
		menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		mobileNavigation.hidden = !open;
		page.toggleAttribute("data-menu-open", open);
		if (hero instanceof HTMLElement) hero.inert = open;
		rebuild();
		if (open) mobileNavigation.querySelector("a")?.focus();
	};

	menuToggle?.addEventListener("click", () => {
		setMenu(!page.hasAttribute("data-menu-open"));
	});

	page.addEventListener("click", (event) => {
		if (!page.hasAttribute("data-menu-open")) return;
		const target = event.target instanceof Element ? event.target.closest("a") : null;
		if (target && mobileNavigation?.contains(target)) {
			setMenu(false);
		}
	});

	addEventListener("keydown", (event) => {
		if (event.key === "Escape" && page.hasAttribute("data-menu-open")) {
			setMenu(false);
			menuToggle?.focus();
		}
	});

	new ResizeObserver(rebuild).observe(page);
	addEventListener("resize", rebuild);
	reducedMotion.addEventListener("change", rebuild);
	document.addEventListener("visibilitychange", () => {
		if (!document.hidden) rebuild();
	});

	for (const image of page.querySelectorAll("[data-dot-image]")) {
		if (image instanceof HTMLImageElement && !image.complete) image.addEventListener("load", rebuild);
	}

	document.fonts.ready.then(rebuild);
	rebuild();
</script>
