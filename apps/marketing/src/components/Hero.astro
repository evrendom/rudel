---
// biome-ignore-all lint/correctness/noUnusedImports: Astro components are referenced from template markup.
import DashboardWindow from "./DashboardWindow.astro";
import HeroTitle from "./HeroTitle.astro";
---

<section class="hero" id="product" data-hero>
	<div class="canvas-fallback" aria-hidden="true"></div>
	<canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
	<HeroTitle />
	<DashboardWindow />
</section>

<style>
	.hero {
		position: relative;
		height: 1271px;
		overflow: clip;
		background: #fff;
	}

	.canvas-fallback,
	.hero-canvas {
		position: absolute;
		z-index: 0;
		inset: var(--site-header-height) 0 0;
		width: 100%;
		height: calc(100% - var(--site-header-height));
	}

	.canvas-fallback {
		background:
			repeating-linear-gradient(
				132deg,
				transparent 0,
				transparent 82px,
				rgba(142, 213, 111, 0.38) 83px,
				rgba(255, 205, 109, 0.38) 84px,
				rgba(251, 130, 167, 0.34) 85px,
				transparent 86px,
				transparent 132px
			),
			radial-gradient(circle at 48% 48%, #fff 0 12%, rgba(255, 255, 255, 0.82) 38%, transparent 72%);
	}

	.hero[data-canvas-ready] .canvas-fallback {
		opacity: 0;
	}

	.hero-canvas {
		z-index: 1;
		pointer-events: none;
	}

	@media (max-width: 767px) {
		.hero {
			height: 1010px;
		}

		.canvas-fallback {
			background:
				repeating-linear-gradient(
					132deg,
					transparent 0,
					transparent 96px,
					rgba(142, 213, 111, 0.4) 97px,
					rgba(255, 205, 109, 0.36) 98px,
					rgba(251, 130, 167, 0.3) 99px,
					transparent 100px,
					transparent 148px
				),
				radial-gradient(circle at 50% 44%, #fff 0 14%, rgba(255, 255, 255, 0.78) 42%, transparent 78%);
		}
	}
</style>
