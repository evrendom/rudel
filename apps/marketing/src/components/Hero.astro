---
// biome-ignore-all lint/correctness/noUnusedImports: Astro components are referenced from template markup.
import DashboardWindow from "./DashboardWindow.astro";
import HeroCanvas from "./HeroCanvas.astro";
import HeroTitle from "./HeroTitle.astro";
---

<section class="hero" id="product" data-hero>
	<HeroCanvas />
	<HeroTitle />
	<DashboardWindow />
</section>

<style>
	.hero {
		position: relative;
		height: 1271.578125px;
		overflow: visible;
		background: transparent;
	}

	@media (min-width: 1024px) and (max-width: 1279px) {
		.hero {
			height: calc(1255.578125px + (100vw - 1024px) * 0.0625);
		}
	}

	@media (min-width: 1280px) and (max-width: 1439px) {
		.hero {
			height: calc(1271.578125px + (100vw - 1280px) * 0.31875);
		}
	}

	@media (min-width: 1440px) {
		.hero {
			height: calc(1322.578125px + (100vw - 1440px) * 0.569140625);
		}
	}

	@media (min-width: 768px) and (max-width: 1023px) {
		.hero {
			height: calc(100svh + 349.53125px);
		}
	}

	@media (max-width: 767px) {
		.hero {
			height: calc(905px + max(0px, (100vw - 430px) * 0.476286765));
		}
	}
</style>
