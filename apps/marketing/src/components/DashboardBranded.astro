---
// biome-ignore-all lint/correctness/noUnusedImports: Astro uses these imports in set:html directives.
import {
	dataPanelHtml,
	dashboardHtml,
	reportingPanelHtml,
} from "./generated/dashboard-branded-data";
import "../styles/dashboard-reporting-static.css";
import "../styles/vendor/attio/dashboard/naturalized.css";
import "../styles/vendor/attio/dashboard/naturalized-composition.css";
import "../styles/dashboard-interactions.css";
---

<Fragment set:html={dashboardHtml} />
<template data-opaline-dashboard-panel-template="Data model">
	<Fragment set:html={dataPanelHtml} />
</template>
<template data-opaline-dashboard-panel-template="Reporting">
	<Fragment set:html={reportingPanelHtml} />
</template>

<script>
	import "../scripts/dashboard";
</script>
