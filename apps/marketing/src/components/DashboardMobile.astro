---
// biome-ignore-all lint/correctness/noUnusedImports: Astro uses this import in a set:html directive.
import {
	mobileDataHtml,
	mobileReportingHtml,
} from "./generated/dashboard-branded-data";
import "../styles/dashboard-reporting-static.css";

interface Props {
	scene?: "Data model" | "Reporting";
}

const { scene = "Data model" } = Astro.props;
const renderedHtml = scene === "Reporting" ? mobileReportingHtml : mobileDataHtml;
---

<Fragment set:html={renderedHtml} />
