---
// biome-ignore-all lint/correctness/noUnusedImports: Astro components are referenced from template markup.
import Aperture from "../components/Aperture.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import MarketingSections from "../components/MarketingSections.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<Aperture />
	<div class="page-shell">
		<Navbar />
		<main>
			<Hero />
			<MarketingSections />
		</main>
		<Footer />
	</div>

	<script>
		import "../scripts/aperture";
		import "../scripts/hero-canvas";
		import "../scripts/motion";
	</script>
</Layout>
