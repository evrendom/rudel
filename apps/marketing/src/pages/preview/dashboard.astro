---
// biome-ignore-all lint/correctness/noUnusedImports: Astro renders imported components in the template.
import DashboardExtracted from "../../components/DashboardExtracted.astro";
import { dashboardPageRoot } from "../../components/generated/dashboard-source-data";
import "../../styles/vendor/attio/dashboard/source.css";
import "../../styles/vendor/attio/dashboard/composition.css";
---

<!doctype html>
<html
	lang="en"
	class={dashboardPageRoot.htmlClass}
	style={dashboardPageRoot.htmlStyle}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Dashboard extraction parity preview</title>
	</head>
	<body class={dashboardPageRoot.bodyClass}>
		<div id="dashboard-gate-source-overlay">
			<main>
				<section>
					<div class="dashboard-gate-stage" data-dashboard-gate-stage>
						<DashboardExtracted />
					</div>
				</section>
			</main>
		</div>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0 !important;
		background: #fff !important;
	}

	#dashboard-gate-source-overlay {
		position: fixed;
		z-index: 2147483647;
		inset: 0;
		background: #fff;
	}

	#dashboard-gate-source-overlay main,
	#dashboard-gate-source-overlay section {
		display: block;
		position: static;
		width: 100%;
		height: 100%;
		padding: 0;
		margin: 0;
		border: 0;
		background: transparent;
	}

	.dashboard-gate-stage {
		position: fixed;
		top: 100px;
		left: 0;
		display: flex;
		width: 100%;
		justify-content: center;
	}
</style>
