---
// biome-ignore-all lint/correctness/noUnusedImports: Astro renders imported components in the template.
import DashboardBranded from "../../components/DashboardBranded.astro";
import { dashboardPageRoot } from "../../components/generated/dashboard-branded-data";
---

<!doctype html>
<html lang="en" class="opaline-dashboard-scope" style={dashboardPageRoot.htmlStyle}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Branded dashboard preview</title>
	</head>
	<body class={dashboardPageRoot.bodyClass}>
		<div id="dashboard-gate-source-overlay" class={dashboardPageRoot.htmlClass}>
			<main>
				<section>
					<div class="dashboard-gate-stage" data-dashboard-gate-stage>
						<DashboardBranded />
					</div>
				</section>
			</main>
		</div>
	</body>
</html>

<style is:global>
	html,
	body { margin: 0 !important; background: #fff !important; }
	#dashboard-gate-source-overlay {
		position: fixed; z-index: 2147483647; inset: 0; background: #fff;
	}
	#dashboard-gate-source-overlay main,
	#dashboard-gate-source-overlay section {
		display: block; position: static; width: 100%; height: 100%; padding: 0;
		margin: 0; border: 0; background: transparent;
	}
	.dashboard-gate-stage {
		position: fixed; top: 100px; left: 0; display: flex; width: 100%;
		justify-content: center;
	}
</style>
