---
import {
	dashboardPageRoot,
	mobileDataHtml,
	mobileReportingHtml,
} from "../../components/generated/dashboard-data";
import "../../styles/vendor/attio/dashboard/naturalized.css";
import "../../styles/vendor/attio/dashboard/naturalized-composition.css";

const renderedHtml = Astro.url.searchParams.get("scene") === "reporting"
	? mobileReportingHtml
	: mobileDataHtml;
---

<!doctype html>
<html lang="en" class="opaline-dashboard-scope" style={dashboardPageRoot.htmlStyle}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Naturalized mobile dashboard preview</title>
	</head>
	<body class={dashboardPageRoot.bodyClass}>
		<div id="dashboard-mobile-gate-source-overlay" class={dashboardPageRoot.htmlClass}>
			<div class="dashboard-mobile-gate-stage"><Fragment set:html={renderedHtml} /></div>
		</div>
	</body>
</html>

<style is:global>
	html, body { margin: 0 !important; background: #fff !important; }
	#dashboard-mobile-gate-source-overlay {
		position: fixed; z-index: 2147483647; inset: 0; background: #fff;
	}
	.dashboard-mobile-gate-stage {
		position: fixed; top: 525px; left: 0; width: 100%;
	}
</style>
