{
	"name": "@rudel/ch-schema",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./connection": "./src/clickhouse-connection.ts",
		"./generated": "./src/generated/index.ts",
		"./wrapped-archetype-centroids": "./src/wrapped-archetype-centroids.ts",
		"./wrapped-archetype-constants": "./src/wrapped-archetype-constants.ts",
		"./wrapped-archetype-rebuild": "./src/wrapped-archetype-rebuild.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"test": "bun test",
		"test:integration": "bun test --max-concurrency=1 ./src/__tests__/codex-mv.integration.ts ./src/__tests__/ingest-clickhouse.integration.ts ./src/__tests__/filter-version-migration.integration.ts ./src/__tests__/session-analytics-migration.integration.ts",
		"ch:generate": "bun --bun chkit generate",
		"ch:generate:dryrun": "bun --bun chkit generate --dryrun",
		"ch:migrate": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit migrate --apply'",
		"ch:status": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit status'",
		"ch:codegen": "bun --bun chkit codegen",
		"ch:drift": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit drift'",
		"ch:backfill:plan": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit backfill plan \"$@\"' --",
		"ch:backfill:run": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit backfill run \"$@\"' --",
		"ch:backfill:status": "bash -c 'CLICKHOUSE_DB=default bun --bun chkit backfill status \"$@\"' --",
		"chcli": "bun scripts/chcli-connect.ts"
	},
	"dependencies": {
		"@chkit/clickhouse": "0.1.0-beta.16",
		"@chkit/codegen": "0.1.0-beta.16",
		"@chkit/core": "0.1.0-beta.16",
		"@chkit/plugin-backfill": "0.1.0-beta.16",
		"@chkit/plugin-codegen": "0.1.0-beta.16",
		"@chkit/plugin-obsessiondb": "0.1.0-beta.16",
		"@chkit/plugin-pull": "0.1.0-beta.16",
		"chkit": "0.1.0-beta.16",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@obsessiondb/chcli": "0.1.1-beta.4",
		"@rudel/typescript-config": "workspace:*",
		"bun-types": "latest",
		"typescript": "5.9.2"
	}
}
